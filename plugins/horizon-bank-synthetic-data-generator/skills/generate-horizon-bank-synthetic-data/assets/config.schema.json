{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizon-bank.example/schemas/synthetic-data-config-1.0.0.json",
  "title": "Horizon Bank synthetic data configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "scale", "archetypes", "modules", "outputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "seed", "scenario_date", "time_mode", "timezone", "locale", "currency"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "scenario_date": {"type": "string", "format": "date"},
        "time_mode": {"enum": ["fixed", "rolling"]},
        "locale": {"type": "string", "minLength": 2},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "timezone": {"type": "string", "minLength": 3}
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset"],
      "properties": {
        "preset": {"enum": ["small", "medium", "large", "custom"]},
        "customers": {"type": "integer", "minimum": 1, "maximum": 100000},
        "history_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "min_transactions": {"type": "integer", "minimum": 0},
        "max_transactions": {"type": "integer", "minimum": 0}
      }
    },
    "archetypes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "youth-guardian",
              "emerging-adult",
              "everyday-banking",
              "family-homebuyer",
              "affluent-investor",
              "small-business-owner",
              "gig-multi-income",
              "retiree-fixed-income",
              "agentic-digital-wallet"
            ]
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "households",
          "businesses",
          "accounts",
          "cards",
          "transactions",
          "incomes",
          "loans",
          "investments",
          "budgets",
          "goals",
          "rewards",
          "alerts",
          "service_interactions",
          "devices",
          "disputes",
          "delegations"
        ]
      }
    },
    "overlays": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "payday",
          "low-balance",
          "overdraft-risk",
          "pending-card-charge",
          "card-dispute",
          "fraud-review",
          "missed-payment",
          "travel",
          "move-home",
          "job-change",
          "healthcare-expense",
          "new-dependent"
        ]
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["bundle-json", "jsonl", "csv", "sqlite", "mongo"]}
        }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["none", "template", "slots"]}
      }
    }
  }
}
